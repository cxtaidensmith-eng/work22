# Generated experiment checkpoints
/experiments/**/*.pt
# Cross-dataset fold histories/checkpoints are strict-resume local state. The
# compact task OOF, fold summaries, smoke JSON, and top-level report are tracked.
/experiments/cross_dataset_a012_structure_v1/formal/
/experiments/cross_dataset_a012_structure_v1/smoke/checkpoint_roundtrip_*.pt
# Prior-free fold histories/checkpoints are strict-resume local state. Only
# compact top-level OOF, summaries, smoke JSON, and report are tracked.
/experiments/prior_free_modality_prior_v1/formal/
/experiments/prior_free_modality_prior_v1/smoke/*_checkpoint_roundtrip.pt
# C1 broad-search fold/trial state is resumable but remains local; only the
# smoke summary, locked manifest, and compact top-level final artifacts commit.
/experiments/c1_broad_hparam_search_v1/stage_a/
/experiments/c1_broad_hparam_search_v1/stage_b/
/experiments/c1_broad_hparam_search_v1/smoke/recovery_probe/
/experiments/c1_broad_hparam_search_v1/stage_b_plan.json
# Generated UM-LER best checkpoints remain local.
/results/um_ler_v1*/**/*.pt
# Frozen Original caches and refiner checkpoints remain local.
/results/um_ler_frozen_v2*/**/*.pt
/results/um_ler_frozen_v2*/**/*.npz
# Component-localization feature caches and best checkpoints remain local.
/results/component_localization_v1/**/*.pt
/results/component_localization_v1/**/*.npz
